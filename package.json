  },
  "dependencies": {
    "@typescript-eslint/utils": "^8.24.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@typescript-eslint/rule-tester": "^8.24.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.9"
  }
